# .env.example - Vorlage fuer die optionale mailer/.env
#
# Kopieren nach mailer/.env und ausfuellen. KEINE Secrets committen!
# Beim Standard-Versand (SMTP) werden E-Mail + Passwort ohnehin zur Laufzeit
# per Login-Popup abgefragt und NICHT gespeichert - diese Datei ist optional.

# Versand-Backend: "smtp" (Standard, Login-Popup) oder "brevo" (API-Key).
MAILER_PROVIDER=smtp

# --- SMTP (nur setzen, wenn die Domain nicht automatisch erkannt wird) ---
# SMTP_HOST=smtp.mail.yahoo.com
# SMTP_PORT=587

# Absender-Anzeigename und optionale Reply-To-Adresse.
MAIL_FROM_NAME=
# REPLY_TO=

# Absenderadresse vorbelegen (Popup-Feld); NICHT das Passwort hier ablegen.
# MAIL_FROM=vorname.nachname@yahoo.com

# --- Brevo-API (nur wenn MAILER_PROVIDER=brevo) ---
# BREVO_API_KEY=xkeysib-...
# MAIL_FROM muss eine in Brevo verifizierte Absenderadresse sein.
